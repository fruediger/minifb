#include <winver.h>

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@MINIFB_COMMIT_COUNT@
    PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@MINIFB_COMMIT_COUNT@
    FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
    FILEFLAGS VS_FF_DEBUG
#else
    FILEFLAGS 0
#endif
    FILEOS      VOS_NT_WINDOWS32
    FILETYPE    @MINIFB_RC_FILETYPE@
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileVersion",      "@PROJECT_VERSION@\0"
            VALUE "OriginalFilename", "@MINIFB_RC_ORIGINAL_FILENAME@\0"
            VALUE "ProductName",      "@PROJECT_NAME@\0"
            VALUE "ProductVersion",   "@PROJECT_VERSION@@MINIFB_RC_PRODUCT_VERSION_SUFFIX@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
