#pragma once

#cmakedefine01 MFB_SHARED_BUILD

#if MFB_SHARED_BUILD
    #if defined(_WIN32)
        #if defined(minifb_EXPORTS) // set automatically by CMake
            #define MFB_EXPORT __declspec(dllexport)
        #else
            #define MFB_EXPORT __declspec(dllimport)
        #endif
    #else
        #define MFB_EXPORT __attribute__((visibility("default")))
    #endif
#else
    #define MFB_EXPORT
#endif
